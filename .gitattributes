# ============================================================================
# .gitattributes —— 换行符与二进制属性（仓库级）
# 依据：docs/repo_spec.md §1（命名与可复现）、§4（真源 vs 产物）
#
# 为什么统一 LF：
#   本工程要能在 Windows（Vivado 2020.2）与 Linux 之间互转，
#   交付评审时对方大概率在 Linux 或 WSL 上 checkout。
#   CRLF 混入会让 .tcl / .sh / Makefile 在 Linux 上直接报错，
#   也会让 git diff 充满 "整文件重写" 的噪声，掩盖真实改动。
# ============================================================================

# --- 兜底规则：文本自动识别，统一 LF -----------------------------------------
* text=auto eol=lf

# --- 设计源码（RTL / HLS / PS 侧 Python）：LF ---------------------------------
*.v      text eol=lf
*.sv     text eol=lf
*.vh     text eol=lf
*.svh    text eol=lf
*.c      text eol=lf
*.h      text eol=lf
*.cpp    text eol=lf
*.hpp    text eol=lf

# --- Xilinx 工具读取的文本文件：必须是 LF，否则 tcl 解析/工程导入报错 --------
# （.xci / .xpr 是 XML 文本，Vivado 可容忍 CRLF，但统一 LF 才能保证 git 里干净）
*.tcl    text eol=lf
*.xdc    text eol=lf
*.xci    text eol=lf
*.xpr    text eol=lf
*.sdc    text eol=lf
*.xsa    binary

# --- 脚本、文档与配置：LF -----------------------------------------------------
*.py     text eol=lf
*.sh     text eol=lf
Makefile text eol=lf
*.mk     text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf

# --- 二进制：禁止任何文本转换（转换会直接损坏产物） ---------------------------
*.bit    binary
*.hwh    binary
*.dcp    binary
*.ltx    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.pdf    binary
*.pptx   binary
*.docx   binary
*.xlsx   binary
